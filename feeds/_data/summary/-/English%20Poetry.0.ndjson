1744060727000	{"id":{"$t":"tag:blogger.com,1999:blog-8657703664257880060.post-6916312574755417211"},"published":{"$t":"2025-04-07T17:18:47.000-04:00"},"updated":{"$t":"2026-11-21T06:33:17.320-05:00"},"category":[{"scheme":"http://www.blogger.com/atom/ns#","term":"English"},{"scheme":"http://www.blogger.com/atom/ns#","term":"English Poetry"},{"scheme":"http://www.blogger.com/atom/ns#","term":"lang-en"},{"scheme":"http://www.blogger.com/atom/ns#","term":"Musings"},{"scheme":"http://www.blogger.com/atom/ns#","term":"Poetry"}],"title":{"type":"text","$t":"note to self."},"summary":{"type":"text","$t":"we are here now, now, now. still fighting for becoming. time is- subjective sense of becoming We are only what we are. here, now- not what we were nanoseconds ago not what we were nanoseconds ago who gives a dam about… here, now- in this universe in the hysteria of present stitched with stars and silence we breathe. not- to miss but to remember we are not always meant to mourn what we are still be"},"link":[{"rel":"replies","type":"application/atom+xml","href":"https://www.kafka.blog/feeds/6916312574755417211/comments/default","title":"Post Comments"},{"rel":"replies","type":"text/html","href":"https://www.kafka.blog/2025/04/note-to-self.html#comment-form","title":"0 Comments"},{"rel":"edit","type":"application/atom+xml","href":"https://www.blogger.com/feeds/8657703664257880060/posts/default/6916312574755417211"},{"rel":"self","type":"application/atom+xml","href":"https://www.blogger.com/feeds/8657703664257880060/posts/default/6916312574755417211"},{"rel":"alternate","type":"text/html","href":"https://www.kafka.blog/2025/04/note-to-self.html","title":"note to self."}],"author":[{"name":{"$t":"Unknown"},"email":{"$t":"noreply@blogger.com"},"gd$image":{"rel":"http://schemas.google.com/g/2005#thumbnail","width":"16","height":"16","src":"https://img1.blogblog.com/img/b16-rounded.gif"}}],"media$thumbnail":{"xmlns$media":"http://search.yahoo.com/mrss/","url":"https://lh3.googleu