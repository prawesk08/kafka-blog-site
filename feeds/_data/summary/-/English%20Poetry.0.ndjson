1743722363000	{"id":{"$t":"tag:blogger.com,1999:blog-8657703664257880060.post-939459783198639030"},"published":{"$t":"2025-04-03T19:19:23.000-04:00"},"updated":{"$t":"2026-11-21T06:33:39.461-05:00"},"category":[{"scheme":"http://www.blogger.com/atom/ns#","term":"English Poetry"},{"scheme":"http://www.blogger.com/atom/ns#","term":"lang-en"},{"scheme":"http://www.blogger.com/atom/ns#","term":"Musings"},{"scheme":"http://www.blogger.com/atom/ns#","term":"Poetry"}],"title":{"type":"text","$t":"dreams, poetry, sunsets."},"summary":{"type":"text","$t":"in the end, it is dreams, poetry, sunsets, mountain blues, someone’s smile, we all have an affair with beautiful things. in the end, it is dreams, poetry, sunsets, mountain blues, someone’s smile, we all have an affair with beautiful things. beauty is an illusion, do I deserve to write about you? ‘does she deserve you writing about her’? none of us are in control; you do not see it as it is, you s"},"link":[{"rel":"replies","type":"application/atom+xml","href":"https://www.kafka.blog/feeds/939459783198639030/comments/default","title":"Post Comments"},{"rel":"replies","type":"text/html","href":"https://www.kafka.blog/2025/04/dreams-poetry-sunsets.html#comment-form","title":"1 Comments"},{"rel":"edit","type":"application/atom+xml","href":"https://www.blogger.com/feeds/8657703664257880060/posts/default/939459783198639030"},{"rel":"self","type":"application/atom+xml","href":"https://www.blogger.com/feeds/8657703664257880060/posts/default/939459783198639030"},{"rel":"alternate","type":"text/html","href":"https://www.kafka.blog/2025/04/dreams-poetry-sunsets.html","title":"dreams, poetry, sunsets."}],"author":[{"name":{"$t":"Unknown"},"email":{"$t":"noreply@blogger.com"},"gd$image":{"rel":"http://schemas.google.com/g/2005#thumbnail","width":"16","height":"16","src":"https://img1.blogblog.com/img/b16-rounded.gif"}}],"media$thumbnail":{"xmlns$media":"http://search.yahoo.com/mrss/","url":"https://lh3.googleusercontent.com/d/1CzbComo8