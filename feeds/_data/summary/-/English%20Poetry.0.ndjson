1747342839000	{"id":{"$t":"tag:blogger.com,1999:blog-8657703664257880060.post-8261333708647815397"},"published":{"$t":"2025-05-15T17:00:39.000-04:00"},"updated":{"$t":"2026-11-21T06:32:22.957-05:00"},"category":[{"scheme":"http://www.blogger.com/atom/ns#","term":"English"},{"scheme":"http://www.blogger.com/atom/ns#","term":"English Poetry"},{"scheme":"http://www.blogger.com/atom/ns#","term":"lang-en"},{"scheme":"http://www.blogger.com/atom/ns#","term":"Musings"},{"scheme":"http://www.blogger.com/atom/ns#","term":"Poetry"}],"title":{"type":"text","$t":"echoes of faded love."},"summary":{"type":"text","$t":"stay, alive in my head a little longer. stay, so that I may go on writing poems against forgetting. stay, so, I may keep on living fighting for surviving. I was not her mirror, nor she mine. we were not possessions- not the kind the world wraps in vows and velvet. but for a while, we lived- we breathed- we exhaled the same wind we burned- on the same trembling planet under the same pale sky. two g"},"link":[{"rel":"replies","type":"application/atom+xml","href":"https://www.kafka.blog/feeds/8261333708647815397/comments/default","title":"Post Comments"},{"rel":"replies","type":"text/html","href":"https://www.kafka.blog/2025/05/echoes-of-faded-love.html#comment-form","title":"0 Comments"},{"rel":"edit","type":"application/atom+xml","href":"https://www.blogger.com/feeds/8657703664257880060/posts/default/8261333708647815397"},{"rel":"self","type":"application/atom+xml","href":"https://www.blogger.com/feeds/8657703664257880060/posts/default/8261333708647815397"},{"rel":"alternate","type":"text/html","href":"https://www.kafka.blog/2025/05/echoes-of-faded-love.html","title":"echoes of faded love."}],"author":[{"name":{"$t":"Unknown"},"email":{"$t":"noreply@blogger.com"},"gd$image":{"rel":"http://schemas.google.com/g/2005#thumbnail","width":"16","height":"16","src":"https://img1.blogblog.com/img/b16-rounded.gif"}}],"media$thumbnail":{"xmlns$media":"http://search.yahoo.com/m