1744888031000	{"id":{"$t":"tag:blogger.com,1999:blog-8657703664257880060.post-3115452383681025937"},"published":{"$t":"2025-04-17T07:07:11.000-04:00"},"updated":{"$t":"2026-11-21T06:19:59.639-05:00"},"category":[{"scheme":"http://www.blogger.com/atom/ns#","term":"English"},{"scheme":"http://www.blogger.com/atom/ns#","term":"English Poetry"},{"scheme":"http://www.blogger.com/atom/ns#","term":"lang-en"},{"scheme":"http://www.blogger.com/atom/ns#","term":"Musings"},{"scheme":"http://www.blogger.com/atom/ns#","term":"Poetry"}],"title":{"type":"text","$t":"old house across the street.."},"summary":{"type":"text","$t":"now, it barely stands. weathering the weather, a far cry from the majesty it once bore. across the street from where i grew up- lies an old house, rotting in its own silence. paint peels like brittle skin, windows nailed shut, a monument to a bygone era. it has seen better days, once stood tall, proud- boasting more rooms than people to fill them. they say it was the first concrete house in the vi"},"link":[{"rel":"replies","type":"application/atom+xml","href":"https://www.kafka.blog/feeds/3115452383681025937/comments/default","title":"Post Comments"},{"rel":"replies","type":"text/html","href":"https://www.kafka.blog/2025/04/old-house-across-the-street.html#comment-form","title":"1 Comments"},{"rel":"edit","type":"application/atom+xml","href":"https://www.blogger.com/feeds/8657703664257880060/posts/default/3115452383681025937"},{"rel":"self","type":"application/atom+xml","href":"https://www.blogger.com/feeds/8657703664257880060/posts/default/3115452383681025937"},{"rel":"alternate","type":"text/html","href":"https://www.kafka.blog/2025/04/old-house-across-the-street.html","title":"old house across the street.."}],"author":[{"name":{"$t":"Unknown"},"email":{"$t":"noreply@blogger.com"},"gd$image":{"rel":"http://schemas.google.com/g/2005#thumbnail","width":"16","height":"16","src":"https://img1.blogblog.com/img/b16-rounded.gif"}}],"media$thumbnail":{"xmlns$med