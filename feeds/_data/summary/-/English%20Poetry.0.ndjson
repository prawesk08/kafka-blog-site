1745535108000	{"id":{"$t":"tag:blogger.com,1999:blog-8657703664257880060.post-5198855329670949858"},"published":{"$t":"2025-04-24T18:51:48.000-04:00"},"updated":{"$t":"2026-11-21T06:32:37.390-05:00"},"category":[{"scheme":"http://www.blogger.com/atom/ns#","term":"English"},{"scheme":"http://www.blogger.com/atom/ns#","term":"English Poetry"},{"scheme":"http://www.blogger.com/atom/ns#","term":"lang-en"},{"scheme":"http://www.blogger.com/atom/ns#","term":"Musings"},{"scheme":"http://www.blogger.com/atom/ns#","term":"Poetry"},{"scheme":"http://www.blogger.com/atom/ns#","term":"top"}],"title":{"type":"text","$t":"blue.. ode to you."},"summary":{"type":"text","$t":"blue, something about you, woke up with thoughts of you, crossed my mind as the storms come through, chaos and calm, bliss and peace, starry nights, and northern lights, folded dreams, holy grails, loud laughs and… blue, something about you, woke up with thoughts of you, crossed my mind as the storms come through, chaos and calm, bliss and peace, starry nights, and northern lights, folded dreams, "},"link":[{"rel":"replies","type":"application/atom+xml","href":"https://www.kafka.blog/feeds/5198855329670949858/comments/default","title":"Post Comments"},{"rel":"replies","type":"text/html","href":"https://www.kafka.blog/2025/04/blue-ode-to-you_3.html#comment-form","title":"2 Comments"},{"rel":"edit","type":"application/atom+xml","href":"https://www.blogger.com/feeds/8657703664257880060/posts/default/5198855329670949858"},{"rel":"self","type":"application/atom+xml","href":"https://www.blogger.com/feeds/8657703664257880060/posts/default/5198855329670949858"},{"rel":"alternate","type":"text/html","href":"https://www.kafka.blog/2025/04/blue-ode-to-you_3.html","title":"blue.. ode to you."}],"author":[{"name":{"$t":"Unknown"},"email":{"$t":"noreply@blogger.com"},"gd$image":{"rel":"http://schemas.google.com/g/2005#thumbnail","width":"16","height":"16","src":"https://img1.blogblog.com/img/b16-rounded.gif"}}],"media$thumbn