1744991823000	{"id":{"$t":"tag:blogger.com,1999:blog-8657703664257880060.post-547262497498981517"},"published":{"$t":"2025-04-18T11:57:03.000-04:00"},"updated":{"$t":"2026-11-21T06:32:48.616-05:00"},"category":[{"scheme":"http://www.blogger.com/atom/ns#","term":"English"},{"scheme":"http://www.blogger.com/atom/ns#","term":"English Poetry"},{"scheme":"http://www.blogger.com/atom/ns#","term":"lang-en"},{"scheme":"http://www.blogger.com/atom/ns#","term":"Musings"},{"scheme":"http://www.blogger.com/atom/ns#","term":"Poetry"}],"title":{"type":"text","$t":"she is not here- but she is everywhere."},"summary":{"type":"text","$t":"sunshine- in human form. knowing she exists, here. now. in this universe- somewhere, anywhere. too holy to touch, too human to forget. not to be held- to be known. and that knowing, softens me. my being. this joy- only… she is not here- but she is everywhere. not in a time, not in a place, not a face, not a name, not a story, not even a memory i can tell. just in her being. she’s out there- somewh"},"link":[{"rel":"replies","type":"application/atom+xml","href":"https://www.kafka.blog/feeds/547262497498981517/comments/default","title":"Post Comments"},{"rel":"replies","type":"text/html","href":"https://www.kafka.blog/2025/04/she-is-not-here-but-she-is-everywhere.html#comment-form","title":"0 Comments"},{"rel":"edit","type":"application/atom+xml","href":"https://www.blogger.com/feeds/8657703664257880060/posts/default/547262497498981517"},{"rel":"self","type":"application/atom+xml","href":"https://www.blogger.com/feeds/8657703664257880060/posts/default/547262497498981517"},{"rel":"alternate","type":"text/html","href":"https://www.kafka.blog/2025/04/she-is-not-here-but-she-is-everywhere.html","title":"she is not here- but she is everywhere."}],"author":[{"name":{"$t":"Unknown"},"email":{"$t":"noreply@blogger.com"},"gd$image":{"rel":"http://schemas.google.com/g/2005#thumbnail","width":"16","height":"16","src":"https://img1.blogblog.com/img/b16-rounded.g