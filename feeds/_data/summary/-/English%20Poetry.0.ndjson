1744218563000	{"id":{"$t":"tag:blogger.com,1999:blog-8657703664257880060.post-7679160562379530947"},"published":{"$t":"2025-04-09T13:09:23.000-04:00"},"updated":{"$t":"2026-11-21T06:33:10.179-05:00"},"category":[{"scheme":"http://www.blogger.com/atom/ns#","term":"English"},{"scheme":"http://www.blogger.com/atom/ns#","term":"English Poetry"},{"scheme":"http://www.blogger.com/atom/ns#","term":"lang-en"},{"scheme":"http://www.blogger.com/atom/ns#","term":"Poetry"},{"scheme":"http://www.blogger.com/atom/ns#","term":"Ramblings"}],"title":{"type":"text","$t":"sunset hues, again with the blues."},"summary":{"type":"text","$t":"the sky- doesn’t beg to be noticed it stretches slow and wide like a secret finally told. one last dance before folding into the arms of dusk, one last twirl into dusk’s arms. sunsets- sometimes feel like the beginning… the sky- spills over at the edge of day, in the whispers of warm oranges. vibrant violets- bleeding softly into blue, blues whispering to first of the thin shadows, what silence re"},"link":[{"rel":"replies","type":"application/atom+xml","href":"https://www.kafka.blog/feeds/7679160562379530947/comments/default","title":"Post Comments"},{"rel":"replies","type":"text/html","href":"https://www.kafka.blog/2025/04/sunsets-again.html#comment-form","title":"0 Comments"},{"rel":"edit","type":"application/atom+xml","href":"https://www.blogger.com/feeds/8657703664257880060/posts/default/7679160562379530947"},{"rel":"self","type":"application/atom+xml","href":"https://www.blogger.com/feeds/8657703664257880060/posts/default/7679160562379530947"},{"rel":"alternate","type":"text/html","href":"https://www.kafka.blog/2025/04/sunsets-again.html","title":"sunset hues, again with the blues."}],"author":[{"name":{"$t":"Unknown"},"email":{"$t":"noreply@blogger.com"},"gd$image":{"rel":"http://schemas.google.com/g/2005#thumbnail","width":"16","height":"16","src":"https://img1.blogblog.com/img/b16-rounded.gif"}}],"media$thumbnail":{"xmlns$media":"http://sear