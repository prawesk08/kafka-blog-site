1781548284000	{"id":{"$t":"tag:blogger.com,1999:blog-8657703664257880060.post-6346830901825795536"},"published":{"$t":"2026-06-15T14:31:24.000-04:00"},"updated":{"$t":"2026-11-21T06:30:09.652-05:00"},"category":[{"scheme":"http://www.blogger.com/atom/ns#","term":"English"},{"scheme":"http://www.blogger.com/atom/ns#","term":"English Poetry"},{"scheme":"http://www.blogger.com/atom/ns#","term":"lang-en"},{"scheme":"http://www.blogger.com/atom/ns#","term":"Letters"},{"scheme":"http://www.blogger.com/atom/ns#","term":"Musings"},{"scheme":"http://www.blogger.com/atom/ns#","term":"Poetry"}],"title":{"type":"text","$t":"marginalia"},"summary":{"type":"text","$t":"A poem about loving the letter more than the sending - and the letter that goes out everywhere but to you. ghosts in the room: five dead writers crowd the room. I underline all. Ghosts in the room - a figure coming apart in the light. I sit to write. I kill the light. the room fills. Kafka first- ‘the written kiss’, he says, ‘stays on the road,’- and Woolf cuts in, - ‘never reaches the far shore, "},"link":[{"rel":"replies","type":"application/atom+xml","href":"https://www.kafka.blog/feeds/6346830901825795536/comments/default","title":"Post Comments"},{"rel":"replies","type":"text/html","href":"https://www.kafka.blog/2026/06/marginalia.html#comment-form","title":"0 Comments"},{"rel":"edit","type":"application/atom+xml","href":"https://www.blogger.com/feeds/8657703664257880060/posts/default/6346830901825795536"},{"rel":"self","type":"application/atom+xml","href":"https://www.blogger.com/feeds/8657703664257880060/posts/default/6346830901825795536"},{"rel":"alternate","type":"text/html","href":"https://www.kafka.blog/2026/06/marginalia.html","title":"marginalia"}],"author":[{"name":{"$t":"Unknown"},"email":{"$t":"noreply@blogger.com"},"gd$image":{"rel":"http://schemas.google.com/g/2005#thumbnail","width":"16","height":"16","src":"https://img1.blogblog.com/img/b16-rounded.gif"}}],"media$thumbnail":{"xmlns$media":"http: