1759604646000	{"id":{"$t":"tag:blogger.com,1999:blog-8657703664257880060.post-7272047175880957942"},"published":{"$t":"2025-10-04T15:04:06.000-04:00"},"updated":{"$t":"2026-11-21T07:27:49.726-05:00"},"category":[{"scheme":"http://www.blogger.com/atom/ns#","term":"lang-en"},{"scheme":"http://www.blogger.com/atom/ns#","term":"Letters"}],"title":{"type":"text","$t":"Dear you, I hope you."},"summary":{"type":"text","$t":"I like you. I adore you. I love you. I hate the word, but it is the only one left. I love you. It is killing me. It is keeping me alive. I like you. I love you. I hope you. Listening to your heart is a tough task, I… Dear you, It’s 3:13 AM. I shouldn’t be writing this. But it is late, and the night has no mercy. The wall of my apartment smells like rain and burnt coffee. The rain no longer feels l"},"link":[{"rel":"replies","type":"application/atom+xml","href":"https://www.kafka.blog/feeds/7272047175880957942/comments/default","title":"Post Comments"},{"rel":"replies","type":"text/html","href":"https://www.kafka.blog/2025/10/dear-you-i-hope-you.html#comment-form","title":"0 Comments"},{"rel":"edit","type":"application/atom+xml","href":"https://www.blogger.com/feeds/8657703664257880060/posts/default/7272047175880957942"},{"rel":"self","type":"application/atom+xml","href":"https://www.blogger.com/feeds/8657703664257880060/posts/default/7272047175880957942"},{"rel":"alternate","type":"text/html","href":"https://www.kafka.blog/2025/10/dear-you-i-hope-you.html","title":"Dear you, I hope you."}],"author":[{"name":{"$t":"Unknown"},"email":{"$t":"noreply@blogger.com"},"gd$image":{"rel":"http://schemas.google.com/g/2005#thumbnail","width":"16","height":"16","src":"https://img1.blogblog.com/img/b16-rounded.gif"}}],"media$thumbnail":{"xmlns$media":"http://search.yahoo.com/mrss/","url":"https://lh3.googleusercontent.com/d/1uYpvUQYM56XIO9zybSHnJhpFcYTfnsoW=s72-w1200-c","height":"72","width":"72"},"thr$total":{"$t":"0"}}