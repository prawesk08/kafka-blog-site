1782122332000	{"id":{"$t":"tag:blogger.com,1999:blog-8657703664257880060.post-7304540429690862931"},"published":{"$t":"2026-06-22T05:58:52.000-04:00"},"updated":{"$t":"2026-11-21T06:30:06.114-05:00"},"category":[{"scheme":"http://www.blogger.com/atom/ns#","term":"lang-ne"},{"scheme":"http://www.blogger.com/atom/ns#","term":"Monologues"},{"scheme":"http://www.blogger.com/atom/ns#","term":"Musings"},{"scheme":"http://www.blogger.com/atom/ns#","term":"Nepali"},{"scheme":"http://www.blogger.com/atom/ns#","term":"Nepali literature"},{"scheme":"http://www.blogger.com/atom/ns#","term":"Nepali Poetry"},{"scheme":"http://www.blogger.com/atom/ns#","term":"Poetry"}],"title":{"type":"text","$t":"शीर्षकविहीन"},"summary":{"type":"text","$t":"तर म जान्दछु, म पुग्दा मेरो घरले मलाई चिन्ने छैन। भित्ता पोतिएको हुनेछ। चौखटले मलाई नचिनी बस्नेछ। चुकुल अहिले कसैले तेल हालिसक्यो होला। बत्तीको स्विच अर्कैको हातले भेट्टाउने छ। र म उभिनेछु, पाहुना भएर, आफ्नै आँगनमा। - a poem on the nomad who fears home is no longer there मैले नहिँडेको ठाउँ कतै बाँकी छैन, तर पुग्ने ठाउँ चाहिँ अब एउटै छैन। घर त एउटा बानी थियो, खिया लागेको चुकुलको कऱ्याककुरुक्, आमाको"},"link":[{"rel":"replies","type":"application/atom+xml","href":"https://www.kafka.blog/feeds/7304540429690862931/comments/default","title":"Post Comments"},{"rel":"replies","type":"text/html","href":"https://www.kafka.blog/2026/06/nomad.html#comment-form","title":"1 Comments"},{"rel":"edit","type":"application/atom+xml","href":"https://www.blogger.com/feeds/8657703664257880060/posts/default/7304540429690862931"},{"rel":"self","type":"application/atom+xml","href":"https://www.blogger.com/feeds/8657703664257880060/posts/default/7304540429690862931"},{"rel":"alternate","type":"text/html","href":"https://www.kafka.blog/2026/06/nomad.html","title":"शीर्षकविहीन"}],"author":[{"name":{"$t":"Unknown"},"email":{"$t":"noreply@blogger.com"},"gd$image":{"rel":"http://schemas.google.com/g/2005#thumbnail","width":"16","height":"16","src":"https://img1.blogblog.com/img/b16-rounded.gif"}}],"media$thumbnail":{"xmlns$media":"http://search.yahoo.com/mrss/","url":"https://lh3.googleusercontent.com/d/1IV7QTErcf3pa_zfvVp7RXUi-BUBwGgaf=s72-w1600-c","height":"72","width":"72"},"thr$total":{"$t":"1"}}
1770290554000	{"id":{"$t":"tag:blogger.com,1999:blog-8657703664257880060.post-6577991222293128915"},"published":{"$t":"2026-02-05T06:22:34.000-05:00"},"updated":{"$t":"2026-11-21T07:27:42.677-05:00"},"category":[{"scheme":"http://www.blogger.com/atom/ns#","term":"English"},{"scheme":"http://www.blogger.com/atom/ns#","term":"lang-en"},{"scheme":"http://www.blogger.com/atom/ns#","term":"Letters"},{"scheme":"http://www.blogger.com/atom/ns#","term":"Monologues"},{"scheme":"http://www.blogger.com/atom/ns#","term":"Musings"}],"title":{"type":"text","$t":"Happy Birthday"},"summary":{"type":"text","$t":"I found you a year ago on this day, and I promised to wish you not virtually the next time around. I failed the geography of that promise, but not the truth of it. This is not just pixels on a screen. It is a heartbeat… Happy Birthday. It’s late. Or early. The hours no longer obey logic when my mind settles on your name. I am writing this because I don’t know how to be quiet when it comes to you. "},"link":[{"rel":"replies","type":"application/atom+xml","href":"https://www.kafka.blog/feeds/6577991222293128915/comments/default","title":"Post Comments"},{"rel":"replies","type":"text/html","href":"https://www.kafka.blog/2026/02/happy-birthday.html#comment-form","title":"0 Comments"},{"rel":"edit","type":"application/atom+xml","href":"https://www.blogger.com/feeds/8657703664257880060/posts/default/6577991222293128915"},{"rel":"self","type":"application/atom+xml","href":"https://www.blogger.com/feeds/8657703664257880060/posts/default/6577991222293128915"},{"rel":"alternate","type":"text/html","href":"https://www.kafka.blog/2026/02/happy-birthday.html","title":"Happy Birthday"}],"author":[{"name":{"$t":"Unknown"},"email":{"$t":"noreply@blogger.com"},"gd$image":{"rel":"http://schemas.google.com/g/2005#thumbnail","width":"16","height":"16","src":"https://img1.blogblog.com/img/b16-rounded.gif"}}],"media$thumbnail":{"xmlns$media":"http://search.yahoo.com/mrss/","url":"https://lh3.googleusercontent.com/d/14AqF0D4VQ6DCk6R0MSjCk9vYAwJbVXVz=s72-w1200-c","height":"72","width":"72"},"thr$total":{"$t":"0"}}
1758756805000	{"id":{"$t":"tag:blogger.com,1999:blog-8657703664257880060.post-1659414610555550539"},"published":{"$t":"2025-09-24T19:33:25.000-04:00"},"updated":{"$t":"2026-11-21T06:31:23.310-05:00"},"category":[{"scheme":"http://www.blogger.com/atom/ns#","term":"lang-ne"},{"scheme":"http://www.blogger.com/atom/ns#","term":"Monologues"},{"scheme":"http://www.blogger.com/atom/ns#","term":"Musings"},{"scheme":"http://www.blogger.com/atom/ns#","term":"Nepali"},{"scheme":"http://www.blogger.com/atom/ns#","term":"Nepali literature"},{"scheme":"http://www.blogger.com/atom/ns#","term":"Nepali Poetry"},{"scheme":"http://www.blogger.com/atom/ns#","term":"Poetry"}],"title":{"type":"text","$t":"नोस्टालजिया पसल"},"summary":{"type":"text","$t":"नोस्टालजिया पसल- कहिल्यै बन्द हुँदैन यहाँ जीवन टुक्रिन्छ र समय हुर्किन्छ, उसका अधुरा सम्झनाहरू गुनासो र मायाको छाप बोकेर मलाई बाँधिरहन्छ। म पसल छोड्न खोज्छु, तर ढोकाबाहिर निस्कँदा फेरि पसलमै फर्केको पाउँछु, “उसको… यस पसलमा मूल्य छैन- बाल्यकालको न्यानो पसिना धूलोले ढाकिएका चाहना टुक्रिएको हाँसो च्यातिएको समय हातमा बाँधिएको घाम, सबै कुरा स्मृतिमा तौलिन्छ सबै यहाँ सजिएको छ न बेचिन्छ, न खरिद हुन्छ। पस"},"link":[{"rel":"replies","type":"application/atom+xml","href":"https://www.kafka.blog/feeds/1659414610555550539/comments/default","title":"Post Comments"},{"rel":"replies","type":"text/html","href":"https://www.kafka.blog/2025/09/nostalgia.html#comment-form","title":"0 Comments"},{"rel":"edit","type":"application/atom+xml","href":"https://www.blogger.com/feeds/8657703664257880060/posts/default/1659414610555550539"},{"rel":"self","type":"application/atom+xml","href":"https://www.blogger.com/feeds/8657703664257880060/posts/default/1659414610555550539"},{"rel":"alternate","type":"text/html","href":"https://www.kafka.blog/2025/09/nostalgia.html","title":"नोस्टालजिया पसल"}],"author":[{"name":{"$t":"Unknown"},"email":{"$t":"noreply@blogger.com"},"gd$image":{"rel":"http://schemas.google.com/g/2005#thumbnail","width":"16","height":"16","src":"https://img1.blogblog.com/img/b16-rounded.gif"}}],"media$thumbnail":{"xmlns$media":"http://search.yahoo.com/mrss/","url":"https://lh3.googleusercontent.com/d/1s8pcg5As-OXIkGtvEAkfBcgyLL1fHNNi=s72-w1200-c","height":"72","width":"72"},"thr$total":{"$t":"0"}}
1744579546000	{"id":{"$t":"tag:blogger.com,1999:blog-8657703664257880060.post-6170454758127648506"},"published":{"$t":"2025-04-13T17:25:46.000-04:00"},"updated":{"$t":"2026-11-21T06:32:59.366-05:00"},"category":[{"scheme":"http://www.blogger.com/atom/ns#","term":"lang-ne"},{"scheme":"http://www.blogger.com/atom/ns#","term":"Monologues"},{"scheme":"http://www.blogger.com/atom/ns#","term":"Musings"},{"scheme":"http://www.blogger.com/atom/ns#","term":"Nepali"},{"scheme":"http://www.blogger.com/atom/ns#","term":"Nepali literature"},{"scheme":"http://www.blogger.com/atom/ns#","term":"Nepali Poetry"},{"scheme":"http://www.blogger.com/atom/ns#","term":"Poetry"},{"scheme":"http://www.blogger.com/atom/ns#","term":"Ramblings"}],"title":{"type":"text","$t":"देशभक्ति।"},"summary":{"type":"text","$t":"देशभक्ति; खुकुरीको धारसँगै चम्किएको थियो रे कुनैबेला, वीरहरूको गर्जनसँगै गर्जिएको थियो रे कुनैबेला, म, यति बेला इतिहास खाएर आफ्नो भोक टार्न सक्दिन, मलाई बलभद्रसँगै देशभक्तिले शाहदत पाएको थाह छ, मलाई अमरसिंहसँगै… देशभक्ति देख्नेहरुले, अलिकति, दौराको फेरमा अल्झिएको देखे, अलिकति, हिमालको टुप्पोमा टल्किएको देखे, अलिकति, स्वयम्भूको आँखामा चम्किएको देखे, अलिकति, नेताको भाषणमा पस्किएको देखे, देख्नेहरुले,"},"link":[{"rel":"replies","type":"application/atom+xml","href":"https://www.kafka.blog/feeds/6170454758127648506/comments/default","title":"Post Comments"},{"rel":"replies","type":"text/html","href":"https://www.kafka.blog/2025/04/deshbhakti.html#comment-form","title":"1 Comments"},{"rel":"edit","type":"application/atom+xml","href":"https://www.blogger.com/feeds/8657703664257880060/posts/default/6170454758127648506"},{"rel":"self","type":"application/atom+xml","href":"https://www.blogger.com/feeds/8657703664257880060/posts/default/6170454758127648506"},{"rel":"alternate","type":"text/html","href":"https://www.kafka.blog/2025/04/deshbhakti.html","title":"देशभक्ति।"}],"author":[{"name":{"$t":"Unknown"},"email":{"$t":"noreply@blogger.com"},"gd$image":{"rel":"http://schemas.google.com/g/2005#thumbnail","width":"16","height":"16","src":"https://img1.blogblog.com/img/b16-rounded.gif"}}],"media$thumbnail":{"xmlns$media":"http://search.yahoo.com/mrss/","url":"https://lh3.googleusercontent.com/d/1cqBgXQ_kkEVCDFfDHo9QHM1WaPQn4rE6=s72-w1200-c","height":"72","width":"72"},"thr$total":{"$t":"1"}}
1742581655000	{"id":{"$t":"tag:blogger.com,1999:blog-8657703664257880060.post-8461694993083405628"},"published":{"$t":"2025-03-21T14:27:35.000-04:00"},"updated":{"$t":"2026-11-21T21:50:56.518-05:00"},"category":[{"scheme":"http://www.blogger.com/atom/ns#","term":"Articles"},{"scheme":"http://www.blogger.com/atom/ns#","term":"lang-ne"},{"scheme":"http://www.blogger.com/atom/ns#","term":"Monologues"},{"scheme":"http://www.blogger.com/atom/ns#","term":"Nepali"},{"scheme":"http://www.blogger.com/atom/ns#","term":"Stories"},{"scheme":"http://www.blogger.com/atom/ns#","term":"top"}],"title":{"type":"text","$t":"आफ्नै संस्मरण १- किताबका कुरा"},"summary":{"type":"text","$t":"योगवीर, सकम्बरी, फुलहरू र बुढी पसल्नी लाई पहिले भेटेँ, अन्तरमुखीमा आँफूलाई पाएँ, परिभाषित आँखाहरुले पर्खालबाहिर धुपी सल्ला र लालीगुराँसको फेदीमा पुर्यायो, अनि महत्ताहिनले थाहै नपाइ बैँसालु वर्तमानमा लगेर छाडी राखेको… I. सानो बेलाबाट नै किताबहरूप्रति मेरो बिछट्टकै मोह थियो। अक्षरहरूकै छाँयामा हुर्किएको मेरा लागि किताबहरु आसक्ति मात्रै थिएनन्, साथीहरु नै तिनै बनेका थिए। आजसम्म पनि रहिरहेका केही नजिक"},"link":[{"rel":"replies","type":"application/atom+xml","href":"https://www.kafka.blog/feeds/8461694993083405628/comments/default","title":"Post Comments"},{"rel":"replies","type":"text/html","href":"https://www.kafka.blog/2025/03/booksandauthors.html#comment-form","title":"1 Comments"},{"rel":"edit","type":"application/atom+xml","href":"https://www.blogger.com/feeds/8657703664257880060/posts/default/8461694993083405628"},{"rel":"self","type":"application/atom+xml","href":"https://www.blogger.com/feeds/8657703664257880060/posts/default/8461694993083405628"},{"rel":"alternate","type":"text/html","href":"https://www.kafka.blog/2025/03/booksandauthors.html","title":"आफ्नै संस्मरण १- किताबका कुरा"}],"author":[{"name":{"$t":"Unknown"},"email":{"$t":"noreply@blogger.com"},"gd$image":{"rel":"http://schemas.google.com/g/2005#thumbnail","width":"16","height":"16","src":"https://img1.blogblog.com/img/b16-rounded.gif"}}],"media$thumbnail":{"xmlns$media":"http://search.yahoo.com/mrss/","url":"https://lh3.googleusercontent.com/d/1IsGQsb_AgDOVGrOq8fQqjW3X_SG7ZUEq=s72-w1200-c","height":"72","width":"72"},"thr$total":{"$t":"1"}}
1734217371000	{"id":{"$t":"tag:blogger.com,1999:blog-8657703664257880060.post-8776658989394577911"},"published":{"$t":"2024-12-14T18:02:51.000-05:00"},"updated":{"$t":"2026-11-21T15:05:19.742-05:00"},"category":[{"scheme":"http://www.blogger.com/atom/ns#","term":"Articles"},{"scheme":"http://www.blogger.com/atom/ns#","term":"lang-ne"},{"scheme":"http://www.blogger.com/atom/ns#","term":"Monologues"},{"scheme":"http://www.blogger.com/atom/ns#","term":"Nepali"},{"scheme":"http://www.blogger.com/atom/ns#","term":"Ramblings"},{"scheme":"http://www.blogger.com/atom/ns#","term":"top"}],"title":{"type":"text","$t":"प्रस्न सोध्यो भनेर पछी लाग्ने हरूलाई जवाफ।"},"summary":{"type":"text","$t":"कहीदिन अधि, यस्तै कसैको बेतुकका कुरा सुन्दा झर्को लागेर होला, एक जानालाई तीन प्रस्न भन्दै सोध्न सुरु गरेथेँ। १। को/कस्तो राजा ल्याउने? २। राजा कसरि ल्याउने? ३। राजा आएर/ल्याएर के हुन्छ त? मैले सोध्न मिल्थ्यो कि नाईँ,… इलन मस्कले टुइटर किनेर; के-के बनाइसक्यो-बनाइसक्यो अहीले, नभए त म टुइटरमा टिएफसी नेपालकै जमानाबाट, यसैगरी नै छु। शीरासकाजीले “कति मीठो ह्यान्डल” भनेको भरमा, उसैको सम्झनाका लागि, पहीले"},"link":[{"rel":"replies","type":"application/atom+xml","href":"https://www.kafka.blog/feeds/8776658989394577911/comments/default","title":"Post Comments"},{"rel":"replies","type":"text/html","href":"https://www.kafka.blog/2024/12/prashna-sodhyo-bhanera.html#comment-form","title":"1 Comments"},{"rel":"edit","type":"application/atom+xml","href":"https://www.blogger.com/feeds/8657703664257880060/posts/default/8776658989394577911"},{"rel":"self","type":"application/atom+xml","href":"https://www.blogger.com/feeds/8657703664257880060/posts/default/8776658989394577911"},{"rel":"alternate","type":"text/html","href":"https://www.kafka.blog/2024/12/prashna-sodhyo-bhanera.html","title":"प्रस्न सोध्यो भनेर पछी लाग्ने हरूलाई जवाफ।"}],"author":[{"name":{"$t":"Unknown"},"email":{"$t":"noreply@blogger.com"},"gd$image":{"rel":"http://schemas.google.com/g/2005#thumbnail","width":"16","height":"16","src":"https://img1.blogblog.com/img/b16-rounded.gif"}}],"media$thumbnail":{"xmlns$media":"http://search.yahoo.com/mrss/","url":"https://lh3.googleusercontent.com/d/1KJQyqFZ8HEXVn0JsXxiG6aBzKXOhqs00=s72-w1600-c","height":"72","width":"72"},"thr$total":{"$t":"1"}}