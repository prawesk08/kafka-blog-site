1743814996000	{"id":{"$t":"tag:blogger.com,1999:blog-8657703664257880060.post-2636302090812877508"},"published":{"$t":"2025-04-04T21:03:16.000-04:00"},"updated":{"$t":"2026-11-21T06:33:35.880-05:00"},"category":[{"scheme":"http://www.blogger.com/atom/ns#","term":"lang-ne"},{"scheme":"http://www.blogger.com/atom/ns#","term":"Nepali"},{"scheme":"http://www.blogger.com/atom/ns#","term":"Nepali literature"},{"scheme":"http://www.blogger.com/atom/ns#","term":"Nepali Poetry"},{"scheme":"http://www.blogger.com/atom/ns#","term":"Poetry"},{"scheme":"http://www.blogger.com/atom/ns#","term":"Ramblings"}],"title":{"type":"text","$t":"मेरो निन्द्रा। मेरो देश।"},"summary":{"type":"text","$t":"यो सडक, त्यो सडक- मान्छे, मोटर-पोखरी छिचोल्दै, निस्किएको - रहेछ त्यो जुलूस; किन?- खै। कसका लागि?- खै। के का लागि?- खै। बुद्ध, गैँडा, सगरमाथा, वीर बलभद्र, अमरसिंह, भिमसेन- इतिहास र भूगोलले धानेको, हाम्रो राष्ट्रियता। धुवाँको क्यामोफ्लाजमा बन्द- स्वेत- श्यामल हिमालहरू, नेपथ्यमा- गुन्जिरहेका भजन, मोटरको घ्यार-घ्यार, ट्यार-ट्यार, अनि- सडकको हिलो छिचोल्दै- हुइँकिरहेको नेपाल यातायात भित्रको- दुई पंक्तिक"},"link":[{"rel":"replies","type":"application/atom+xml","href":"https://www.kafka.blog/feeds/2636302090812877508/comments/default","title":"Post Comments"},{"rel":"replies","type":"text/html","href":"https://www.kafka.blog/2025/04/collectivestupidity.html#comment-form","title":"0 Comments"},{"rel":"edit","type":"application/atom+xml","href":"https://www.blogger.com/feeds/8657703664257880060/posts/default/2636302090812877508"},{"rel":"self","type":"application/atom+xml","href":"https://www.blogger.com/feeds/8657703664257880060/posts/default/2636302090812877508"},{"rel":"alternate","type":"text/html","href":"https://www.kafka.blog/2025/04/collectivestupidity.html","title":"मेरो निन्द्रा। मेरो देश।"}],"author":[{"name":{"$t":"Unknown"},"email":{"$t":"noreply@blogger.com"},"gd$image":{"rel":"http://schemas.google.com/g/2005#thumbnail","width":"16","height":"16","src":"https://img1.blogblog.com/img/b16