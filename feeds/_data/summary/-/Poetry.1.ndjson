1743638245000	{"id":{"$t":"tag:blogger.com,1999:blog-8657703664257880060.post-2376337397365240265"},"published":{"$t":"2025-04-02T19:57:25.000-04:00"},"updated":{"$t":"2026-11-21T06:21:01.538-05:00"},"category":[{"scheme":"http://www.blogger.com/atom/ns#","term":"English"},{"scheme":"http://www.blogger.com/atom/ns#","term":"English Poetry"},{"scheme":"http://www.blogger.com/atom/ns#","term":"lang-en"},{"scheme":"http://www.blogger.com/atom/ns#","term":"Musings"},{"scheme":"http://www.blogger.com/atom/ns#","term":"Poetry"}],"title":{"type":"text","$t":"Muse"},"summary":{"type":"text","$t":"'a fishermen knows- the sea is dangerous and the storm is terrible', but that doesn't - keep him ashore. it's his hope: of chasing dreams- of loving the living- and the fight of becoming, that brings him back into the… do you remember; the morning and the evening bells when you were at school? both sounded the same - yet: one would- always makes you sad, and the other- always brought you joy, even"},"link":[{"rel":"replies","type":"application/atom+xml","href":"https://www.kafka.blog/feeds/2376337397365240265/comments/default","title":"Post Comments"},{"rel":"replies","type":"text/html","href":"https://www.kafka.blog/2025/04/muse.html#comment-form","title":"0 Comments"},{"rel":"edit","type":"application/atom+xml","href":"https://www.blogger.com/feeds/8657703664257880060/posts/default/2376337397365240265"},{"rel":"self","type":"application/atom+xml","href":"https://www.blogger.com/feeds/8657703664257880060/posts/default/2376337397365240265"},{"rel":"alternate","type":"text/html","href":"https://www.kafka.blog/2025/04/muse.html","title":"Muse"}],"author":[{"name":{"$t":"Unknown"},"email":{"$t":"noreply@blogger.com"},"gd$image":{"rel":"http://schemas.google.com/g/2005#thumbnail","width":"16","height":"16","src":"https://img1.blogblog.com/img/b16-rounded.gif"}}],"media$thumbnail":{"xmlns$media":"http://search.yahoo.com/mrss/","url":"https://lh3.googleusercontent.com/d/1d4vfKbyFs6eCGy2c