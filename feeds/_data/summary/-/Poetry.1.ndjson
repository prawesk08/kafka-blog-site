1742863946000	{"id":{"$t":"tag:blogger.com,1999:blog-8657703664257880060.post-5973007474028633530"},"published":{"$t":"2025-03-24T20:52:26.000-04:00"},"updated":{"$t":"2026-11-21T06:33:57.615-05:00"},"category":[{"scheme":"http://www.blogger.com/atom/ns#","term":"lang-ne"},{"scheme":"http://www.blogger.com/atom/ns#","term":"Nepali"},{"scheme":"http://www.blogger.com/atom/ns#","term":"Nepali literature"},{"scheme":"http://www.blogger.com/atom/ns#","term":"Nepali Poetry"},{"scheme":"http://www.blogger.com/atom/ns#","term":"Poetry"},{"scheme":"http://www.blogger.com/atom/ns#","term":"Ramblings"}],"title":{"type":"text","$t":"भावसुन्य:"},"summary":{"type":"text","$t":"हुल बाँधेर- एकोहोरो ताली बजाउने, स्वप्न स्वर्ग- स्वप्न वर्तमान, नस्ट्याल्जिया फ्यान्टासीमा- अडिएको- अनवरत अस्तित्व यात्रा, मानौं पहिलो सुल्टो जुलूस हो इतिहासको। सबेरै- हाइना हाँस्छन्, साझै- कुखुरा बास्छन्; नयाँ बिहान?… फेरि राजाकै कुरा: फेरि अनुहारकै बहस- आए पनि, नआए पनि, के फरक? जो आए पनि- जसरि आए पनि- जे भन्दै आए पनि- परिणाम उही, देशको अनुहार उस्तै, हिजो जस्तो, आज जस्तै, भोली पनि उस्तै। नाम त बद"},"link":[{"rel":"replies","type":"application/atom+xml","href":"https://www.kafka.blog/feeds/5973007474028633530/comments/default","title":"Post Comments"},{"rel":"replies","type":"text/html","href":"https://www.kafka.blog/2025/03/bhavsunya.html#comment-form","title":"1 Comments"},{"rel":"edit","type":"application/atom+xml","href":"https://www.blogger.com/feeds/8657703664257880060/posts/default/5973007474028633530"},{"rel":"self","type":"application/atom+xml","href":"https://www.blogger.com/feeds/8657703664257880060/posts/default/5973007474028633530"},{"rel":"alternate","type":"text/html","href":"https://www.kafka.blog/2025/03/bhavsunya.html","title":"भावसुन्य:"}],"author":[{"name":{"$t":"Unknown"},"email":{"$t":"noreply@blogger.com"},"gd$image":{"rel":"http://schemas.google.com/g/2005#thumbnail","width":"16","height":"16","src":"https://img1.blogblog.com/img/b16-rounded.gif"}}],"media$thumbnail":{"xmlns$media":