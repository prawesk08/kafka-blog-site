1794932505095	{"id":{"$t":"tag:blogger.com,1999:blog-8657703664257880060.post-5060120735184123146"},"published":{"$t":"2026-11-17T11:21:45.095-05:00"},"updated":{"$t":"2026-11-23T17:15:20.425-05:00"},"category":[{"scheme":"http://www.blogger.com/atom/ns#","term":"Articles"},{"scheme":"http://www.blogger.com/atom/ns#","term":"lang-ne"},{"scheme":"http://www.blogger.com/atom/ns#","term":"Nepali"},{"scheme":"http://www.blogger.com/atom/ns#","term":"Published Articles"},{"scheme":"http://www.blogger.com/atom/ns#","term":"Stories"}],"title":{"type":"text","$t":"भुईँ छाडेको गाउँको कथा"},"summary":{"type":"text","$t":"सडक आएपछि आफूलाई सानो ठानेको एउटा पहाडी गाउँ, र डाँडामा ठडिएको टावरको कथा । पहाडी गाउँमाथिको डाँडा । अंक १ गाउँको सिरानमा, बर-पिपलका पुराना एकजोडा रुख थिए। एकले अर्कोलाई अँगालोमा बाँधेर अनादिकालदेखि उभिएका जस्तै लाग्ने । कति पुराना हुन्, कसैले ठ्याक्कै भन्न सक्दैन थिए । बुढाहरू भन्थे- “हामी सानो हुँदा पनि यिनको छाहरी यस्तै शीतल थियो, हाम्रा बुबाहरू पनि यही छायाँमा सुस्ताएर जवान भएका हुँदा हुन् ।” "},"link":[{"rel":"replies","type":"application/atom+xml","href":"https://www.kafka.blog/feeds/5060120735184123146/comments/default","title":"Post Comments"},{"rel":"replies","type":"text/html","href":"https://www.kafka.blog/2026/11/bhui-chhadeko-gaun-katha.html#comment-form","title":"0 Comments"},{"rel":"edit","type":"application/atom+xml","href":"https://www.blogger.com/feeds/8657703664257880060/posts/default/5060120735184123146"},{"rel":"self","type":"application/atom+xml","href":"https://www.blogger.com/feeds/8657703664257880060/posts/default/5060120735184123146"},{"rel":"alternate","type":"text/html","href":"https://www.kafka.blog/2026/11/bhui-chhadeko-gaun-katha.html","title":"भुईँ छाडेको गाउँको कथा"}],"author":[{"name":{"$t":"Unknown"},"email":{"$t":"noreply@blogger.com"},"gd$image":{"rel":"http://schemas.google.com/g/2005#thumbnail","width":"16","height":"16","src":"https://img1.blogblog.com/img/b16-rounded.gif"}}],"media$thumbnail":{"xmlns$media":"http://sea