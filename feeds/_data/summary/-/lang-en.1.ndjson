1678049071000	{"id":{"$t":"tag:blogger.com,1999:blog-8657703664257880060.post-5133695364241710417"},"published":{"$t":"2023-03-05T15:44:31.000-05:00"},"updated":{"$t":"2026-11-21T14:58:17.162-05:00"},"category":[{"scheme":"http://www.blogger.com/atom/ns#","term":"Articles"},{"scheme":"http://www.blogger.com/atom/ns#","term":"English"},{"scheme":"http://www.blogger.com/atom/ns#","term":"lang-en"},{"scheme":"http://www.blogger.com/atom/ns#","term":"Ramblings"}],"title":{"type":"text","$t":"Oh! Arsenal.. you have never made me feel so proud."},"summary":{"type":"text","$t":"There are 12 more games in the season, and things are going to change. Yesterday’s win truly made me believe that we can do this. I hope we do; it doesn’t matter if we don’t. What this team has achieved is already… I fell in love with football through Tony Adams and Arsene Wenger’s arsenal as a 10 year old, but being an Arsenal fan has been one complicated relationship all through my adult life. W"},"link":[{"rel":"replies","type":"application/atom+xml","href":"https://www.kafka.blog/feeds/5133695364241710417/comments/default","title":"Post Comments"},{"rel":"replies","type":"text/html","href":"https://www.kafka.blog/2023/03/oh-arsenal-you-have-never-made-me-feel-so-proud.html#comment-form","title":"0 Comments"},{"rel":"edit","type":"application/atom+xml","href":"https://www.blogger.com/feeds/8657703664257880060/posts/default/5133695364241710417"},{"rel":"self","type":"application/atom+xml","href":"https://www.blogger.com/feeds/8657703664257880060/posts/default/5133695364241710417"},{"rel":"alternate","type":"text/html","href":"https://www.kafka.blog/2023/03/oh-arsenal-you-have-never-made-me-feel-so-proud.html","title":"Oh! Arsenal.. you have never made me feel so proud."}],"author":[{"name":{"$t":"Unknown"},"email":{"$t":"noreply@blogger.com"},"gd$image":{"rel":"http://schemas.google.com/g/2005#thumbnail","width":"16","height":"16","src":"https://img1.blogblog.com/img/b16-rounded.gif"}}],"media$thu