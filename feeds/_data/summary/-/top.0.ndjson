1749381379000	{"id":{"$t":"tag:blogger.com,1999:blog-8657703664257880060.post-3110789935019848683"},"published":{"$t":"2025-06-08T07:16:19.000-04:00"},"updated":{"$t":"2026-11-21T06:32:15.787-05:00"},"category":[{"scheme":"http://www.blogger.com/atom/ns#","term":"lang-ne"},{"scheme":"http://www.blogger.com/atom/ns#","term":"Nepali"},{"scheme":"http://www.blogger.com/atom/ns#","term":"Nepali literature"},{"scheme":"http://www.blogger.com/atom/ns#","term":"Nepali Poetry"},{"scheme":"http://www.blogger.com/atom/ns#","term":"Poetry"},{"scheme":"http://www.blogger.com/atom/ns#","term":"Ramblings"},{"scheme":"http://www.blogger.com/atom/ns#","term":"top"}],"title":{"type":"text","$t":"म थर नभएको आत्मा।"},"summary":{"type":"text","$t":"म थरबाट जन्मिएँ - तर थर कहिल्यै मेरो थिएन। त्यो बुवाको थर थियो, बुबाको पनि, हरेक बुबाहरूको इतिहासमा मातृकुल हराइरहेको प्रमाण। किनभने - म होइन, मेरो थर पो थियो यस देशको नागरिता। म जन्मिँदा - छाला एउटै थियो, रगत एउटै, हाँसो एउटै। तर धर्म आयो - उसले मलाई जातमा काट्यो, थरमा टाँस्यो। उसले भन्यो - “तिमी यो होइनौ। तिमी त्यो - जसले छोएपछि पानी पनि अछुतो हुन्छ।” “पवित्रता किन आगोमा नापिन्छ?” चुलो छोएर कोही"},"link":[{"rel":"replies","type":"application/atom+xml","href":"https://www.kafka.blog/feeds/3110789935019848683/comments/default","title":"Post Comments"},{"rel":"replies","type":"text/html","href":"https://www.kafka.blog/2025/06/nosurnames.html#comment-form","title":"2 Comments"},{"rel":"edit","type":"application/atom+xml","href":"https://www.blogger.com/feeds/8657703664257880060/posts/default/3110789935019848683"},{"rel":"self","type":"application/atom+xml","href":"https://www.blogger.com/feeds/8657703664257880060/posts/default/3110789935019848683"},{"rel":"alternate","type":"text/html","href":"https://www.kafka.blog/2025/06/nosurnames.html","title":"म थर नभएको आत्मा।"}],"author":[{"name":{"$t":"Unknown"},"email":{"$t":"noreply@blogger.com"},"gd$image":{"rel":"http://schemas.google.com/g/2005#thumbnail","width":"16","height":"16","src":"https://img1.blogblog.com/img/b16-rounded.gif"}}],"media$thumbnail":{"xmlns$media":"http://search.yahoo.com/mrss/","url":"https://lh3.googleusercontent.com/d/14VA6oKyQvOI3vWPAOkiJuLlgs-4DrBK5=s72-w1200-c","height":"72","width":"72"},"thr$total":{"$t":"2"}}
1745535108000	{"id":{"$t":"tag:blogger.com,1999:blog-8657703664257880060.post-5198855329670949858"},"published":{"$t":"2025-04-24T18:51:48.000-04:00"},"updated":{"$t":"2026-11-21T06:32:37.390-05:00"},"category":[{"scheme":"http://www.blogger.com/atom/ns#","term":"English"},{"scheme":"http://www.blogger.com/atom/ns#","term":"English Poetry"},{"scheme":"http://www.blogger.com/atom/ns#","term":"lang-en"},{"scheme":"http://www.blogger.com/atom/ns#","term":"Musings"},{"scheme":"http://www.blogger.com/atom/ns#","term":"Poetry"},{"scheme":"http://www.blogger.com/atom/ns#","term":"top"}],"title":{"type":"text","$t":"blue.. ode to you."},"summary":{"type":"text","$t":"blue, something about you, woke up with thoughts of you, crossed my mind as the storms come through, chaos and calm, bliss and peace, starry nights, and northern lights, folded dreams, holy grails, loud laughs and… blue, something about you, woke up with thoughts of you, crossed my mind as the storms come through, chaos and calm, bliss and peace, starry nights, and northern lights, folded dreams, "},"link":[{"rel":"replies","type":"application/atom+xml","href":"https://www.kafka.blog/feeds/5198855329670949858/comments/default","title":"Post Comments"},{"rel":"replies","type":"text/html","href":"https://www.kafka.blog/2025/04/blue-ode-to-you_3.html#comment-form","title":"2 Comments"},{"rel":"edit","type":"application/atom+xml","href":"https://www.blogger.com/feeds/8657703664257880060/posts/default/5198855329670949858"},{"rel":"self","type":"application/atom+xml","href":"https://www.blogger.com/feeds/8657703664257880060/posts/default/5198855329670949858"},{"rel":"alternate","type":"text/html","href":"https://www.kafka.blog/2025/04/blue-ode-to-you_3.html","title":"blue.. ode to you."}],"author":[{"name":{"$t":"Unknown"},"email":{"$t":"noreply@blogger.com"},"gd$image":{"rel":"http://schemas.google.com/g/2005#thumbnail","width":"16","height":"16","src":"https://img1.blogblog.com/img/b16-rounded.gif"}}],"media$thumbn