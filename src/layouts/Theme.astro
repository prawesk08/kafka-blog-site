 var box=null,cur=null,tok=0;
 function draw(l){
  if(!box)return;cur=l;var my=++tok;box.classList.add('is-loading');
  if(l==='ne'||l==='en'){
   Promise.all([feed(l),popular()]).then(function(rr){var list=rr[0],pop=rr[1];if(my!==tok)return;
    var lp=pop.filter(function(p){return p.lang===l}).slice(0,5),seen={};lp.forEach(function(p){seen[p.url]=1});var rest=list.filter(function(p){return !seen[p.url]});rest.slice(0,10).forEach(function(p){seen[p.url]=1});
