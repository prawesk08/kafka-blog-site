 var cache={};
 function rk(list,pop,l){var seen={},out=[];pop.filter(function(p){return p.lang===l}).concat(list).forEach(function(p){if(p&&!seen[p.url]){seen[p.url]=1;out.push(p)}});return out}
 function feed(lang){var k=lang||'all';if(cache[k])return cache[k];
  cache[k]=fetch('/feeds/posts/summary'+(lang==='ne'?'/-/Nepali':lang==='en'?'/-/English':'')+'?alt=json&max-results=15').then(function(r){return r.json()}).then(function(j){
   return ((j.feed&&j.feed.entry)||[]).map(function(e){var l=(e.link||[]).filter(function(x){return x.rel==='alternate'})[0];
    return {url:l?l.href:'',title:(e.title&&e.title.$t)||'',img:thumb(e.media$thumbnail&&e.media$thumbnail.url),date:fdate(e.published&&e.published.$t)}})}).catch(function(){delete cache[k];return []});
  return cache[k]}
 var allP=null;
