 function allPosts(){if(!allP)allP=fetch('/feeds/posts/summary?alt=json&max-results=500').then(function(r){return r.json()}).then(function(j){var by={},bt={};
   ((j.feed&&j.feed.entry)||[]).forEach(function(e){var l=(e.link||[]).filter(function(x){return x.rel==='alternate'})[0];if(!l)return;var cats=(e.category||[]).map(function(c){return c.term});var t=(e.title&&e.title.$t)||'';
    var p={url:l.href,title:t,img:thumb(e.media$thumbnail&&e.media$thumbnail.url),date:fdate(e.published&&e.published.$t),lang:cats.indexOf('Nepali')>-1?'ne':cats.indexOf('English')>-1?'en':(isNe(t)?'ne':'en')};by[pathOf(l.href)]=p;bt[norm(t)]=p});return {by:by,bt:bt}}).catch(function(){allP=null;return {by:{},bt:{}}});return allP}
 /* Most read: Blogger's own popular-posts list (server-rendered in #kafka-pop), filled in from the post list */
 function popular(){return allPosts().then(function(m){var seen={};return [].map.call(document.querySelectorAll('#kafka-pop a'),function(a){var h=a.getAttribute('href');return (h&&m.by[pathOf(h)])||m.bt[norm(a.textContent)]||null}).filter(function(p){if(!p||seen[p.url])return false;seen[p.url]=1;return true})})}
 function row(p){var ne=isNe(p.title);return '<a class="k5" href="'+esc(p.url)+'"><span class="k5-img"'+(p.img?' style="background-image:url(\''+esc(p.img)+'\')"':'')+'></span><span class="k5-b"><span class="k5-t"'+(ne?' lang="ne"':'')+'>'+esc(p.title)+'</span><span class="k5-d">'+esc(p.date)+'</span></span></a>'}
