     +'<div class="k3col k3c"><p class="k3h"><span lang="ne">धेरै पढिएका</span> <span class="k3en">Most read</span></p>'+lp.map(row).join('')
       +(fill.length?'<p class="k3sub">'+(L?'पुरानो सङ्ग्रहबाट':'From the archive')+'</p>'+fill.map(row).join(''):'')+'<a class="k5-more" href="#kafka-top">'+(L?'थप ›':'More ›')+'</a></div>';
     box.classList.remove('is-loading');
   });
  }else{
   Promise.all([feed('ne'),feed('en'),popular()]).then(function(r){var pop=r[2];if(my!==tok)return;var mr=pop.slice(0,5),sn={};mr.forEach(function(p){sn[p.url]=1});var nx=function(a){return a.filter(function(p){return !sn[p.url]}).slice(0,5)};
